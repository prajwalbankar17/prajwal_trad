# ---------------------------------------------------------------------------
# Prajwal Trading Platform - environment template
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="Prajwal Trading Platform"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_JSON=false
TIMEZONE=Asia/Kolkata

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_64_byte_url_safe_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=10

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=prajwal_trading
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# SAFETY SWITCHES - DO NOT ENABLE WITHOUT EXPLICIT AUTHORISATION
# Live order execution is disabled by default and is NOT implemented in Phase 1.
# ---------------------------------------------------------------------------
LIVE_TRADING_ENABLED=false
EXECUTION_MODE=paper              # paper only in Phase 1
ALLOW_LIVE_ORDER_PLACEMENT=false

# --- Trading defaults (overridable per risk profile in DB) ---
DEFAULT_CAPITAL=1000000
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_OPEN_POSITIONS=5
MAX_TRADES_PER_DAY=20
MAX_CAPITAL_UTILISATION_PCT=80.0

# --- Broker: Zerodha Kite Connect (BLOCKED until credentials supplied) ---
BROKER_NAME=zerodha
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_REQUEST_TOKEN=

# --- Anthropic Claude (BLOCKED until key supplied) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_MONTHLY_BUDGET_USD=20
AI_ENABLED=false

# --- Notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Historical data import ---
SQLITE_SOURCE_PATH=./data/sqlite_source/equity_1min.sqlite
IMPORT_BATCH_SIZE=50000
